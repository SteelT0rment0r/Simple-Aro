{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

    "logo": {
        "type": "builtin",
        "source": "gentoo",
        "padding": {
            "top": 1,
            "right": 3
        }
    },

    "display": {
        "separator": "  "
    },

    "modules": [
        {
            "type": "title",
            "format": "{user-name}@{host-name}"
        },

        "break",

        {
            "type": "os",
            "key": "󰣇 OS"
        },
        {
            "type": "command",
            "key": "󰅐 Age",
            "text": "birth=$(stat -c %W /); now=$(date +%s); echo $(( (now - birth) / 86400 )) days"
        },
        {
            "type": "kernel",
            "key": "󰒋 Kernel"
        },
        {
            "type": "uptime",
            "key": "󰔚 Uptime"
        },

        "break",

        {
            "type": "de",
            "key": "󰧨 DE"
        },
        {
            "type": "wm",
            "key": "󰖲 WM"
        },
        {
            "type": "terminal",
            "key": "󰆍 Terminal"
        },
        {
            "type": "shell",
            "key": "󰘧 Shell"
        },

        "break",

        {
            "type": "cpu",
            "key": "󰍛 CPU"
        },
        {
            "type": "gpu",
            "key": "󰢮 GPU"
        },
        {
            "type": "memory",
            "key": "󰍛 Memory"
        },

        "break",

        {
            "type": "disk",
            "key": "󰋊 Disk",
            "folders": [
                "/"
            ]
        }
    ]
}
