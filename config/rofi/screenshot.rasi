configuration {
    show-icons: false;
}

@import "shared/colors.rasi"
@import "shared/fonts.rasi"

window {
    transparency: "real";
    location: center;
    anchor: center;
    width: 520px;
    border: 1px solid;
    border-radius: 8px;
    border-color: @selected;
    background-color: @background;
}

mainbox {
    spacing: 10px;
    margin: 0px;
    padding: 30px;
    background-color: transparent;
    children: [ "inputbar", "message", "listview" ];
}

inputbar {
    spacing: 10px;
    padding: 0px;
    background-color: transparent;
    text-color: @foreground;
    children: [ "prompt" ];
}

prompt {
    padding: 10px;
    border-radius: 8px;
    background-color: @selected;
    text-color: @background;
}

message {
    margin: 0px;
    padding: 10px;
    border-radius: 8px;
    background-color: @background-alt;
    text-color: @foreground;
}

textbox {
    background-color: inherit;
    text-color: inherit;
    vertical-align: 0.5;
    horizontal-align: 0.0;
}

listview {
    columns: 1;
    lines: 5;
    spacing: 8px;
    layout: vertical;
    scrollbar: true;
    background-color: transparent;
}

element {
    padding: 12px 20px;
    border: 0px;
    border-radius: 8px;
    background-color: @background-alt;
    text-color: @foreground;
    cursor: pointer;
}

element-text {
    expand: true;
    font: "sans 12";
    background-color: transparent;
    text-color: inherit;
    vertical-align: 0.5;
    horizontal-align: 0.5;
}

element normal.normal {
    background-color: @background-alt;
    text-color: @foreground;
}

element selected.normal {
    background-color: @selected;
    text-color: @background;
}
scrollbar {
    handle-width: 2px;
    handle-color: @selected;
    border-radius: 8px;
    background-color: @background-alt;
}
