/*****----- Rofi Wallpaper Picker -----*****/
/* Pywal-themed thumbnail grid */

configuration {
    show-icons: true;
}

* {
    background:      @background;
    card:            @background-alt;
    foreground:      @foreground;
    muted:           @foreground;
    selected:        @selected;
    active:          @active;
    font:            "JetBrains Mono 11";
}

@import "shared/colors.rasi"

/*****----- Floating box -----*****/
window {
    transparency:     "real";
    location:         center;
    anchor:           center;
    fullscreen:       false;
    width:            1180px;
    border-radius:    20px;
    border:           0px solid;
    background-color: @background;
    cursor:           "default";
}

mainbox {
    children: [ "inputbar", "listview", "message" ];
    padding:  20px;
    spacing:  18px;
    background-color: transparent;
}

/*****----- Input / title bar -----*****/
inputbar {
    children:         [ "textbox-prompt-colon", "entry" ];
    spacing:          14px;
    padding:          0px 0px 6px 0px;
    background-color: transparent;
    text-color:       @foreground;
}

textbox-prompt-colon {
    expand:           false;
    str:              "  Wallpaper";
    padding:          12px 22px;
    border-radius:    100%;
    background-color: @card;
    text-color:       @foreground;
    vertical-align:   0.5;
}

entry {
    padding:          12px 22px;
    border-radius:    100%;
    background-color: @card;
    text-color:       @foreground;
    cursor:           text;
    placeholder:      "Search…";
    placeholder-color: @muted;
    vertical-align:   0.5;
}

/*****----- Thumbnail grid -----*****/
listview {
    columns:       4;
    lines:         2;
    spacing:       18px;
    cycle:         true;
    dynamic:       true;
    scrollbar:     false;
    fixed-columns: true;
    fixed-height:  true;
    background-color: transparent;
}

/*****----- Tile -----*****/
element {
    orientation:      vertical;
    padding:          10px;
    spacing:          8px;
    border-radius:    16px;
    background-color: @card;
    cursor:           pointer;
}

element-icon {
    size:             200px;
    border-radius:    12px;
    cursor:           inherit;
    background-color: transparent;
}

element-text {
    horizontal-align: 0.5;
    vertical-align:   0.5;
    text-color:       @foreground;
    cursor:           inherit;
    background-color: transparent;
}

element selected {
    background-color: @selected;
    border:           3px solid;
    border-color:     @selected;
    text-color:       @foreground;
}

/*****----- Bottom hint bar -----*****/
message {
    background-color: transparent;
}

textbox {
    padding:          12px 22px;
    border-radius:    100%;
    background-color: @card;
    text-color:       @muted;
    horizontal-align: 0.5;
    vertical-align:   0.5;
}
