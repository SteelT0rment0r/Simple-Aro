/** Common style **/
#backlight,
#battery,
#clock,
#pulseaudio,
#network,
#bluetooth {
    background-color: @background-alt;
	color: @foreground;
}

#backlight, 
#battery,
#clock,
#idle_inhibitor,
#mode,
#window,
#mpd,
#custom-spotify,
#pulseaudio,
