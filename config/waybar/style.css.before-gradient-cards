
/** ********** Import Colors ********** **/
@import "../../.cache/wal/colors-waybar.css";

/** ********** Fonts ********/
* {
    font-family: "DejaVu Sans Mono";
    font-size: 10px;
    font-weight: bold;
}
/** ********** Waybar Window ********** **/
window#waybar {
    background-color: @background;
	color: @background;
    border-bottom: 2px solid @background-alt;
    transition-property: background-color;
    transition-duration: .5s;
}

window#waybar.hidden {
    opacity: 0.8;
}

window#waybar.empty {
}
window#waybar.solo {
}
window#waybar.thunar {
}
window#waybar.geany {
}

/** ********** Backlight ********** **/
#backlight {
}

/** ********** Battery ********** **/
#battery {
}

#battery.charging {
}

#battery.plugged {
}

@keyframes blink {
    to {
        color: @background-alt;
    }
}

#battery.critical:not(.charging) {
    color: @red;
    animation-name: blink;
    animation-duration: 0.5s;
    animation-timing-function: linear;
    animation-iteration-count: infinite;
    animation-direction: alternate;
}

/** ********** Clock ********** **/
#clock {
}

/** ********** Sway ********** **/
#workspaces {
    background-color: @background-alt;
    color: @foreground;
    border-radius: 0px 8px 0px 0px;
    padding: 0px;
}

#workspaces button {
	color: @foreground;
	margin: 0px 2px;
	padding: 2px 6px;
}

#workspaces button:hover {
	background-color: @background;
	color: @white;
	border: 0px solid @background;
	border-radius: 8px;
	padding: 2px 6px;
}

#workspaces button.visible {
	background-image: linear-gradient(to right, @cyan , @blue);
}

#workspaces button.focused {
	background-color: @green;
}

#workspaces button.urgent {
	background-color: @red;
}

#workspaces button.persistent {
	background-color: @yellow;
}

#workspaces button.visible,
#workspaces button.focused,
#workspaces button.urgent,
#workspaces button.persistent {
	color: @background;
	border-radius: 8px;
	padding: 2px 6px;
}

#workspaces button.current_output {
}

#workspaces button#sway-workspace-1 {
}

/* If workspaces is the leftmost module, omit left margin */
.modules-left > widget:first-child > #workspaces {
    margin-left: 0;
}

/* If workspaces is the rightmost module, omit right margin */
.modules-right > widget:last-child > #workspaces {
    margin-right: 0;
}

#mode {
    background-color: @background-alt;
	color: @selected;
    font-weight: bold;
}

#window {
	background-color: @background-alt;
	color: @foreground;
}
window#waybar.empty #window {
	background-color: transparent;
}

/** ********** Tray ********** **/
#tray {
	background-color: @background-alt;
	border-radius: 8px 0px 0px 0px;
	padding: 4px 6px;
}
#tray > .passive {
    -gtk-icon-effect: dim;
}
#tray > .needs-attention {
    -gtk-icon-effect: highlight;
}
#tray > .active {
}

/** ********** MPD/Spotify ********** **/
@keyframes gradient {
	0% {
		background-position: 0% 50%;
	}
	50% {
		background-position: 100% 50%;
	}
	100% {
		background-position: 0% 50%;
	}
}

#mpd,
#mpd.paused,
#custom-spotify,
#custom-spotify.paused {
	background-color: @background-alt;
	color: @foreground;
}

#mpd.disconnected,
#custom-spotify.offline,
#mpd.stopped {
	background-color: @background-alt;
	color: @red;
}

#mpd.playing,
#custom-spotify.playing {
    background: linear-gradient(90deg, @cyan 25%, @blue 50%, @magenta 75%, @red 100%); 
    background-size: 250% 250%;
    animation: gradient 8s ease infinite;
    text-shadow: 0 0 5px rgba(0, 0, 0, 0.377);
    color: @background;
}

/** ********** Idle Inhibitor ********** **/
#idle_inhibitor {
    background-color: @background-alt;
	color: @green;
}
#idle_inhibitor.deactivated {
	color: @red;
}

